<?xml version="1.0" ?>
<!--
  c2l-v3-scaled — тележка c2l-v3, но корпус base_link взят из меша c2
  (base_link_c2-v3.stl), растянутого до габаритов c2l: собственного меша
  base_link_c2l-v3.stl в пакете нет.

  c2l больше c2 на ~100 мм с каждой стороны по X и на ~75 мм по Y
  (по смещениям ToF); высота та же. Меш c2: x[-0.471 .. 0.36], y[-0.235 .. 0.235]
      scale X = 0.46 / 0.36  = 1.278
      scale Y = 0.31 / 0.235 = 1.319
  Масштаб идёт от начала base_link, поэтому ручка (-X) уходит на ~3 см дальше
  реальной. Остальное (ToF, колёса, лидар, крепление руки) — как в c2l-v3.

  Запуск: robot_model:=c2l-v3-scaled
-->
<robot name="quasi_c2l-v3-scaled" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="base_mesh" value="base_link_c2-v3.stl" />
  <xacro:property name="base_mesh_scale" value="1.278 1.319 1" />

  <xacro:include filename="c2l-v3.urdf.xacro" />
</robot>
