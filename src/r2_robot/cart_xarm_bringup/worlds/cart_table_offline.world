<?xml version="1.0" ?>
<!--
  Простейший world без Fuel-зависимостей (для оффлайн-запуска):
  плоский пол + выровненный стол + коробка pick_box (захват) + цилиндрический блок.
  Подробности сцены: docs/STATUS.md.
-->
<sdf version="1.6">
  <world name="cart_xarm_world_offline">

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!--
      Стол. ВЫРОВНЕН: плоская столешница 1.2 x 0.8 x 0.05 м, верх строго на
      z = 0.925 м (мир), 4 ножки сходятся со столешницей без зазоров
      (раньше между «ножкой-коробкой» и столешницей был зазор 2.5 см).
      Центр стола x = 1.05 м: ближний край x = 0.45 м — в 3-9 см от носа
      тележки (spawn 0,0), рука (база x=-0.0075, z=0.919) достаёт до объектов
      на столе. Верх стола в link_base руки: z = +0.006 м.
      Геометрию менять синхронно с docs/STATUS.md (раздел «Сцена»).
    -->
    <model name="table_simple">
      <static>true</static>
      <pose>1.05 0.0 0 0 0 0</pose>
      <link name="link">
        <!-- столешница: центр z=0.90, толщина 0.05 => верх 0.925 -->
        <visual name="top_visual">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
        <collision name="top_collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <!-- 4 ножки 0.06 x 0.06, от пола (z=0) до низа столешницы (z=0.875) -->
        <visual name="leg_fl_visual">
          <pose>0.55 0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="leg_fl_collision">
          <pose>0.55 0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.55 -0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="leg_fr_collision">
          <pose>0.55 -0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.55 0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="leg_bl_collision">
          <pose>-0.55 0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>-0.55 -0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="leg_br_collision">
          <pose>-0.55 -0.35 0.4375 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.875</size></box></geometry>
        </collision>
      </link>
    </model>

    <!--
      pick_box — ОБЪЕКТ ДЛЯ ЗАХВАТА ПРИСОСКОЙ: прямоугольная коробка
      0.10 (X) x 0.05 (Y) x 0.05 (Z, высота) м, масса 0.1 кг.
      ДИНАМИЧЕСКАЯ модель (не static!): иначе DetachableJoint не сможет унести
      её вместе с рукой. Лежит на столешнице: центр z = 0.925 + 0.025 + 0.0005
      (0.5 мм запас, чтобы не стартовать с проникновением).
      Положение (x=0.60, y=0): в 0.6 м от базы руки — внутри досягаемости xArm6.
      Имя модели 'pick_box' и link 'link' зашиты в плагин DetachableJoint
      (quasi_cart_description/urdf/cart-arm.xacro, xacro-аргумент
      vacuum_target_model) и в параметры vacuum_gripper_sim (launch).
      Инерция бокса: Ixx = m/12 (y²+z²), Iyy = m/12 (x²+z²), Izz = m/12 (x²+y²).
    -->
    <model name="pick_box">
      <pose>0.60 0.0 0.9505 0 0 0</pose>
      <!-- Публикует ТОЛЬКО позу модели (не всех звеньев мира) 10 Гц: этим пользуется
           vacuum_gripper_sim для проверки касания. Топик:
           /model/pick_box/pose (Pose_V) -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>10</update_frequency>
      </plugin>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>4.1667e-5</ixx><iyy>1.0417e-4</iyy><izz>1.0417e-4</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><box><size>0.10 0.05 0.05</size></box></geometry>
          <material><ambient>0.1 0.45 0.85 1</ambient><diffuse>0.1 0.5 0.9 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.10 0.05 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Цилиндрический блок (r=0.04, h=0.09) — прежний объект, теперь стоит НА столешнице
         (раньше парил на 5 см над ней) сбоку от pick_box; static. -->
    <model name="cylinder_block">
      <static>true</static>
      <pose>0.80 -0.28 0.9705 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.04</radius><length>0.09</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!--
      ОБЯЗАТЕЛЬНЫЕ системные плагины gz sim 9 (Harmonic).
      Без них симуляция "падает чисто" (process has finished cleanly):
      gz sim не может поднять физику/сцены без SceneBroadcaster и Physics,
      а ros_gz_bridge ждёт топики /clock и /world/.../pose, которые
      публикуют именно эти плагины.
    -->
    <!-- Sensors-система объявляется ТОЛЬКО здесь, в мире. Модель (cart_with_arm)
         собирается с model_sensors_plugin:=false; второй экземпляр Sensors
         создаёт дубликат сцены "scene" -> segfault в libgz-sim-sensors-system. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- /clock для use_sim_time во всех ROS2-нодах -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

  </world>
</sdf>
