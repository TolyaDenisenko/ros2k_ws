<?xml version="1.0" ?>
<robot name="quasi_c2" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="camera_roll_offset" value="$(arg camera_roll_offset)" />
  <xacro:property name="camera_pitch_offset" value="$(arg camera_pitch_offset)" />

  <link name="base_footprint" />

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="drive_link" />
    <origin xyz="0 0 ${base_axis_z_offset}" rpy="0 0 0" />
  </joint>

  <link name="drive_link">
    <inertial>
      <origin xyz="1.11022302462516E-15 3.84381027928966E-15 -2.3037127760972E-15" rpy="0 0 0" />
      <mass value="9.8174770424681E-05" />
      <inertia ixx="3.5792885050665E-10" ixy="1.71200513021298E-27" ixz="1.94111863664301E-42"
        iyy="3.06796157577128E-10" iyz="-6.71520157584803E-26" izz="3.5792885050665E-10" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find quasi_cart_description)/meshes/drive_link.stl" />
      </geometry>
      <material name="">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find quasi_cart_description)/meshes/drive_link.stl" />
      </geometry>
    </collision>
  </link>

