<?xml version="1.0"?>
<!--
  cart_with_arm.urdf.xacro — тележка quasi_cart (репозиторий r2_robot)
  + манипулятор xArm6 с вакуумным гриппером и камерой на ЭФ.

  Рука расположена ПО ЦЕНТРУ верхней плоской платформы тележки:
  joint arm_mount_joint (base_link -> arm_mount_link, xyz="-0.0075 0 0.849"),
  затем world_joint руки (arm_mount_link -> link_base).

  Этот URDF имеет ПРЯМУЮ ссылку на добавленный манипулятор:
      <xacro:include filename="cart-arm.xacro"/>
      <xacro:mount_xarm6_on_cart/>   # xArm6 + add_vacuum_gripper + D435i camera

  Проверка генерации:
      xacro cart_with_arm.urdf.xacro use_sim:=true
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cart_with_arm">

    <!-- ==================== Аргументы ==================== -->
    <xacro:arg name="use_sim" default="false" />
    <xacro:arg name="robot_model" default="c2" />
    <xacro:arg name="simulator" default="ignition" />
    <xacro:arg name="enable_floor_tofs" default="true" />
    <xacro:arg name="camera_roll_offset" default="0.0"/>
    <xacro:arg name="camera_pitch_offset" default="0.0"/>
    <xacro:arg name="enable_extra_floor_tofs" default="false"/>
    <xacro:arg name="enable_camera_realsense" default="false"/>
    <xacro:arg name="enable_camera_oak" default="false"/>
    <xacro:arg name="enable_camera_orbbec" default="false"/>
    <xacro:arg name="enable_pace_battery" default="true"/>
    <!-- Sensors-система gz объявлена в мирах cart_xarm_bringup/worlds/*.world.
         Дублирование в модели (cart-sensors.ign.xacro + realsense_gz руки)
         давало 3 экземпляра -> "Scene already exists with name: scene" и
         segfault в libgz-sim-sensors-system. Объявлено ДО include'ов, чтобы
         этот default перекрыл default=true во вложенных файлах. -->
    <xacro:arg name="model_sensors_plugin" default="false"/>

    <!-- Аргументы руки (пробрасываются в cart-arm.xacro) -->
    <xacro:arg name="arm_dof" default="6"/>
    <xacro:arg name="arm_prefix" default=""/>
    <xacro:arg name="arm_hw_ns" default="xarm"/>
    <xacro:arg name="arm_offset_xyz" default="0 0 0"/>
    <xacro:arg name="arm_offset_rpy" default="0 0 0"/>
    <xacro:arg name="arm_ros2_control_plugin" default="gz_ros2_control/GazeboSimSystem"/>

    <xacro:property name="var_simulator" value="$(arg simulator)"/>
    <!-- property robot_model ОБЯЗАТЕЛЕН: cart-base.urdf.xacro использует
         выражение ${robot_model.startswith('c2w')} (есть в cart.urdf.xacro,
         но не в этом файле-обёртке — без него xacro падает с
         "name 'robot_model' is not defined") -->
    <xacro:property name="robot_model" value="$(arg robot_model)"/>
    <xacro:property name="drive" value="differential"/>

    <material name="white_pva"><color rgba="1 1 1 1"/></material>
    <material name="dark"><color rgba="0.1 0.1 0.1 1"/></material>
    <material name="yellow"><color rgba="0.9 0.9 0 1"/></material>
    <material name="dark_yellow"><color rgba="0.7 0.7 0 1"/></material>

    <!-- ==================== ТЕЛЕЖКА (как в cart.urdf.xacro) ==================== -->
    <xacro:include filename="$(arg robot_model).urdf.xacro"/>
    <xacro:include filename="cart-drive-${drive}.urdf.xacro"/>
    <xacro:include filename="cart-base.urdf.xacro"/>

    <xacro:if value="$(arg use_sim)">
        <xacro:if value="${var_simulator == 'ignition'}">
            <xacro:include filename="cart.ign.xacro" />
            <xacro:property name="var_wheel_type" value="continuous"/>
            <!--
              ФИКС "модель тележки не загрузилась / рука наполовину":
              cart-sensors.ign.xacro безусловно добавлял
                  <gazebo reference="camera_rgb_camera_frame"> ... </gazebo>
              (rgbd_camera-сенсор realsense), но link camera_rgb_camera_frame
              существует ТОЛЬКО при enable_camera_realsense:=true (там подключается
              _d455.urdf.xacro). gz-parser при спавне видит сенсор на несуществующем
              звене и ОТКАЗЫВАЕТСЯ импортировать ВСЮ модель -> тележка не появляется,
              а рука отображается частично (link'и без mesh видны как примитивы RViz,
              mesh-звенья — нет).

              Исправление сделано в двух местах:
              1) cart-sensors.ign.xacro — блок камеры теперь обёрнут в
                 <xacro:if value="$(arg enable_camera_realsense)">;
              2) здесь, в cart_with_arm, include cart-sensors.ign.xacro выполняется
                 ВСЕГДА при simulator==ignition (как в оригинальном cart.urdf.xacro):
                 вместе с камерой возвращаются ОБЯЗАТЕЛЬные для симуляции плагины
                 Sensors (render_engine ogre2) и Imu — без них rgbd-камера гриппера
                 D435i не публиковала бы данные, и grasp_analyzer был бы слеп.
                 Все остальные ссылки cart-sensors.ign.xacro (imu_link, lidar_link,
                 tof1..8_link) легальны: эти link'и определены безусловно в
                 cart-base.urdf.xacro.
              Топики остаются /model/cart/* — launch cart_xarm_bringup использует
              gz_bridge.yaml именно с этими именами (изменение namespace сломало бы
              мосты clock/odom/camera).
            -->
            <xacro:include filename="cart-sensors.ign.xacro" />
            <!-- Состояние ведущих колёс: их не публикует ни ros2_control
                 (joint_state_broadcaster знает только суставы руки), ни что-то
                 ещё -> у drive_wheel_*_link не было TF ("No transform" в RViz).
                 Gazebo публикует реальные углы колёс, gz_bridge отдаёт их в
                 /cart/wheel_joint_states, joint_state_publisher в launch
                 сливает их с /joint_states руки для robot_state_publisher. -->
            <gazebo>
              <plugin filename="gz-sim-joint-state-publisher-system"
                      name="gz::sim::systems::JointStatePublisher">
                <topic>/model/cart/wheel_joint_states</topic>
                <joint_name>drive_wheel_left_joint</joint_name>
                <joint_name>drive_wheel_right_joint</joint_name>
              </plugin>
            </gazebo>
        </xacro:if>
    </xacro:if>

    <!-- ==================== МАНИПУЛЯТОР НА ТЕЛЕЖКЕ ==================== -->
    <!-- Ссылка на руку: include + вызов макроса mount_xarm6_on_cart.
         Внутри: xArm6 dof=$(arg arm_dof) + add_vacuum_gripper=true
         + add_realsense_d435i=true (камера гриппера для grasp_analyzer). -->
    <xacro:include filename="cart-arm.xacro"/>
    <xacro:mount_xarm6_on_cart/>

</robot>
