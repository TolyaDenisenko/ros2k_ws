<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quasi_r2_msgs</name>
  <version>2.0.0</version>
  <description>Various messages used in Quasi R2 robot</description>
  <license>Proprietary</license>
  <author email="fedor@quasi.ai">Fedor Bokov</author>
  <maintainer email="fedor@quasi.ai">Fedor Bokov</maintainer>
  <url type="repository">git.quasi.ai:/repos/quasi_r2.git</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>action_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>quasi_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>