<?xml version="1.0"?>
<!--
  cart-arm.xacro — интеграция манипулятора xArm6 с вакуумным гриппером
  и камерой на ЭФ (Realsense D435i) в URDF тележки quasi_cart (r2_robot).

  Манипулятор ставится СТРОГО ПО ЦЕНТРУ верхней плоской платформы тележки.
  Координаты верхнего листа base_link (по мешу base_link_c2-v3.stl):
      z_top = 0.849 м,  x[-0.359 .. 0.359], y[-0.235 .. 0.235]
  Центр платформы в base_link: (-0.0075, 0.0) — сюда крепится база руки.

  Использование (из cart_with_arm.urdf.xacro):
      <xacro:include filename="cart-arm.xacro"/>
      <xacro:mount_xarm6_on_cart/>

  Важно: пакет xarm_description должен присутствовать в workspace (он даёт
  макросы xarm_device / realsense_gz и меши руки + присоски).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cart_arm">

  <!-- ==================== Собственные аргументы ==================== -->
  <xacro:arg name="arm_dof" default="6"/>
  <xacro:arg name="arm_prefix" default=""/>
  <xacro:arg name="arm_hw_ns" default="xarm"/>
  <!-- Поза базы руки относительно центра верхней платформы (доп. смещение) -->
  <xacro:arg name="arm_offset_xyz" default="0 0 0"/>
  <xacro:arg name="arm_offset_rpy" default="0 0 0"/>
  <!-- ros2_control плагин: для Gazebo Sim используйте gz_ros2_control/GazeboSimSystem -->
  <xacro:arg name="arm_ros2_control_plugin" default="gz_ros2_control/GazeboSimSystem"/>
  <!-- Камера на фланце: gemini335le (Orbbec, quasi_camera_description) | d435i (старая
       RealSense из xarm_description). use_sim=true -> номинальные фреймы + gz-сенсор. -->
  <xacro:arg name="camera_model" default="gemini335le"/>
  <xacro:arg name="gripper_camera_preview" default="false"/>
  <!-- Модель Gazebo, которую присоска может «приварить» (DetachableJoint).
       Должна совпадать с именем модели в мире (cart_table_offline.world: pick_box). -->
  <xacro:arg name="vacuum_target_model" default="pick_box"/>

  <!-- ==================== Фланец крепления на крыше тележки ==================== -->
  <!-- Точка крепления зависит от тележки: файл модели (<robot_model>.urdf.xacro,
       подключается раньше) может задать свойство arm_mount_xyz.
       Default — центр платформы c2: x=-0.0075 (середина [-0.359..0.359]),
       y=0, z=верх 0.849 -->
  <xacro:property name="arm_mount_xyz" default="-0.0075 0.0 0.849"/>

  <xacro:macro name="arm_mount_link" params="">
    <!-- Фиктивный link-«фланец» на верхней плоской платформе тележки -->
    <link name="arm_mount_link"/>

    <joint name="arm_mount_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_mount_link"/>
      <origin xyz="${arm_mount_xyz}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ==================== Установка xArm6 на тележку ==================== -->
  <xacro:macro name="mount_xarm6_on_cart" params="">

    <xacro:arm_mount_link/>

    <!-- Подключаем описание xArm (официальный пакет xarm_ros2) -->
    <xacro:include filename="$(find xarm_description)/urdf/xarm_device_macro.xacro"/>

    <!--
      attach_to="arm_mount_link" — рука ЖЁСТКО вшита в URDF тележки;
      add_vacuum_gripper=true   — вакуумная присоска на link_eef;
      add_realsense_d435i=true  — камера гриппера: топики camera/color/image_raw,
                                  camera/color/camera_info, camera/depth/points
                                  публикуются из Gazebo (realsense_gz при
                                  ros2_control_plugin=gz_ros2_control/GazeboSimSystem).
    -->
    <xacro:xarm_device
      prefix="$(arg arm_prefix)"
      hw_ns="$(arg arm_hw_ns)"
      dof="$(arg arm_dof)"
      robot_type="xarm"
      limited="false"
      effort_control="false"
      velocity_control="false"
      add_gripper="false"
      add_vacuum_gripper="true"
      add_bio_gripper="false"
      add_realsense_d435i="${'$(arg camera_model)' == 'd435i'}"
      add_d435i_links="true"
      add_gripper_camera="${'$(arg camera_model)' != 'd435i'}"
      gripper_camera_model="$(arg camera_model)"
      gripper_camera_nominal="$(arg use_sim)"
      gripper_camera_gz="$(arg use_sim)"
      gripper_camera_preview="$(arg gripper_camera_preview)"
      ros2_control_plugin="$(arg arm_ros2_control_plugin)"
      ros2_control_params="$(find xarm_controller)/config/xarm6_controllers.yaml"
      load_gazebo_plugin="true"
      attach_to="arm_mount_link"
      attach_xyz="$(arg arm_offset_xyz)"
      attach_rpy="$(arg arm_offset_rpy)"
    />

    <!--
      Симуляция вакуума (use_sim=true): логическая присоска на DetachableJoint.
      Физической присоски в gz нет, поэтому «вакуум» = жёсткое соединение
      (fixed joint) между звеном руки и объектом:
        /vacuum/attach (Empty) -> соединение создаётся с ТЕКУЩИМ взаимным
                                  положением (объект не телепортируется);
        /vacuum/detach (Empty) -> соединение удаляется, объект падает;
        /vacuum/state (String) <- "attached" / "detached".
      parent_link = link6: в SDF fixed-суставы URDF схлопываются, и присоска
      (xarm_vacuum_gripper_link), link_eef, камера лежат внутри звена link6
      (проверено: gz sdf -p на сгенерированном URDF).
      Когда слать attach — решает нода vacuum_gripper_sim (проверяет касание).
    -->
    <xacro:if value="$(arg use_sim)">
      <gazebo>
        <plugin filename="gz-sim-detachable-joint-system"
                name="gz::sim::systems::DetachableJoint">
          <parent_link>link6</parent_link>
          <child_model>$(arg vacuum_target_model)</child_model>
          <child_link>link</child_link>
          <attach_topic>/vacuum/attach</attach_topic>
          <detach_topic>/vacuum/detach</detach_topic>
          <output_topic>/vacuum/state</output_topic>
          <suppress_child_warning>true</suppress_child_warning>
        </plugin>
        <!-- Поза модели робота в мире (10 Гц) — для проверки касания присоской -->
        <plugin filename="gz-sim-pose-publisher-system"
                name="gz::sim::systems::PosePublisher">
          <publish_model_pose>true</publish_model_pose>
          <publish_link_pose>false</publish_link_pose>
          <publish_collision_pose>false</publish_collision_pose>
          <publish_visual_pose>false</publish_visual_pose>
          <publish_sensor_pose>false</publish_sensor_pose>
          <use_pose_vector_msg>true</use_pose_vector_msg>
          <update_frequency>10</update_frequency>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
