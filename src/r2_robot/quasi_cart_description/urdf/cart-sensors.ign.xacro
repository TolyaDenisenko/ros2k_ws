  <gazebo reference="lidar_link">
    <material>Gazebo/FlatBlack</material>
    <sensor type="gpu_lidar" name="ydlidar_tg15_sensor">
      <topic>/model/cart/lidar</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <frame_id>lidar_link</frame_id>
      <pose>0 0 0 0 0 0</pose>
      <visualize>$(arg laser_visual)</visualize>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>2000</samples>
            <resolution>1</resolution>
            <min_angle>${-pi}</min_angle> <!-- -143 degree -->
            <max_angle>${pi}</max_angle>  <!--  116 degree -->
          </horizontal>
        </scan>
        <range>
          <min>0.38</min>
          <max>30.0</max>
          <resolution>0.005</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <xacro:property name="var_camera_width" value="848"/>
  <xacro:property name="var_camera_height" value="480"/>
  <xacro:property name="var_camera_fov" value="1.50098"/>

  <!-- ФИКС: rgbd-сенсор корпуса ссылается на link camera_rgb_camera_frame,
       который существует ТОЛЬКО при enable_camera_realsense:=true
       (_d455.urdf.xacro в cart-base.urdf.xacro). Без условия gz-parser
       отказывался импортировать всю модель (тележка не спавнилась). -->
  <xacro:if value="$(arg enable_camera_realsense)">
  <gazebo reference="camera_rgb_camera_frame">
    <sensor type="rgbd_camera" name="realsense">
      <topic>/model/cart/realsense</topic>
      <ignition_frame_id>camera_rgb_camera_frame</ignition_frame_id>
      <frame_id>camera_rgb_camera_frame</frame_id>
      <always_on>1</always_on>
      <update_rate>15.0</update_rate>
      <visualize>$(arg camera_visual)</visualize>
      <camera name="realsense">
        <optical_frame_id>camera_rgb_camera_optical_frame</optical_frame_id>
        <horizontal_fov>${var_camera_fov}</horizontal_fov>
        <lens>
          <intrinsics>
            <fx>${var_camera_width*.5/tan(var_camera_fov*.5)}</fx>
            <fy>${var_camera_width*.5/tan(var_camera_fov*.5)}</fy>
            <cx>${(var_camera_width + 1)/2}</cx>
            <cy>${(var_camera_height + 1)/2}</cy>
            <s>1.0</s>
          </intrinsics>
          <projection>
            <p_fx>${var_camera_width*.5/tan(var_camera_fov*.5)}</p_fx>
            <p_fy>${var_camera_width*.5/tan(var_camera_fov*.5)}</p_fy>
            <p_cx>${(var_camera_width + 1)/2}</p_cx>
            <p_cy>${(var_camera_height + 1)/2}</p_cy>
            <tx>0.0</tx>
            <ty>0.0</ty>
          </projection>
        </lens>>
        <image>
          <width>${var_camera_width}</width>
          <height>${var_camera_height}</height>
          <format>B8G8R8</format>
        </image>
        <depth_camera>
        </depth_camera>
        <clip>
          <near>0.3</near>
          <far>6</far>
          <!--far>3.0</far-->
        </clip>
      </camera>
    </sensor>
  </gazebo>
  </xacro:if>  <!-- enable_camera_realsense -->

</robot>