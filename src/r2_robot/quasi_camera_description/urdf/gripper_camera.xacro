<?xml version="1.0"?>
<!--
  gripper_camera.xacro — камера на фланце руки (eye-in-hand): кронштейн + камера.

  Подключается «крючком» из xarm_description/urdf/xarm_device_macro.xacro
  (параметры add_gripper_camera / gripper_camera_model / ...).

  Геометрия (в фрейме link_eef, Z — по оси инструмента, присоска до z=0.1265,
  TCP z=0.126, радиус присоски ~0.046 м). Кронштейн Camera_Stand_1300: пластина
  3 мм на фланце (z 0..0.003), лапка с пазами в сторону +X до x=0.0755.
  Камера прикручена ЗАДНЕЙ панелью к лапке (со стороны присоски) и смотрит
  вдоль оси инструмента:
    mount_rpy = 0 -π/2 0  — X камеры (взгляд) -> +Z инструмента, Y (ширина
                            124 мм) -> +Y (поперёк лапки), Z (верх) -> -X
                            (верх к оси, нижняя грань с винтом 1/4" — наружу);
    mount_xyz = 0.075 0 0.015 — нижний винт: нижняя грань на краю лапки
                            (x=0.075, корпус по высоте 29 мм занимает x
                            0.046..0.075 — вплотную к присоске, не пересекая);
                            задняя панель (12 мм позади винта) на пластине
                            z = 0.015 - 0.012 = 0.003.
  Присоска частично видна в краю кадра (камера в ~60 мм от оси) — так и на
  железе. Уточнить по калибровке (документ 08).
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="gripper_camera"
      params="camera_model parent:=link_eef name:=gripper_camera
              mount_xyz:='0.075 0 0.015' mount_rpy:='0 ${-pi/2} 0'
              use_nominal_extrinsics:=true add_gz_sensor:=false preview:=false">

    <!-- Кронштейн Camera_Stand_1300 (STL из CAD, мм -> scale 0.001): пластина 3 мм
         между фланцем и присоской. Диск Ø75 (отверстие Ø30, крепёж) — на фланец
         соосно link_eef; лапка 45x60 мм с пазами под камеру — в сторону +X
         link_eef (до x=75.5 мм). Оси меша: Y — толщина (0..3 мм), X — к лапке,
         Z — поперёк; rpy = (π/2, 0, 0): Y меша -> Z инструмента, Z меша -> -Y. -->
    <joint name="${name}_bracket_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${parent}"/>
      <child link="${name}_bracket_link"/>
    </joint>
    <link name="${name}_bracket_link">
      <inertial>
        <!-- алюминий 3 мм, ~0.06 кг; центр масс смещён к лапке -->
        <origin xyz="0.012 0 0.0015" rpy="0 0 0"/>
        <mass value="0.06"/>
        <inertia ixx="2.5e-5" ixy="0" ixz="0" iyy="5.0e-5" iyz="0" izz="7.5e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="file://$(find quasi_camera_description)/meshes/brackets/camera_stand_1300.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${name}_bracket_mat"><color rgba="0.75 0.75 0.78 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <mesh filename="file://$(find quasi_camera_description)/meshes/brackets/camera_stand_1300.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <xacro:if value="${camera_model == 'gemini335le'}">
      <xacro:include filename="$(find quasi_camera_description)/urdf/cameras/gemini335le.xacro"/>
      <xacro:camera_body_gemini335le name="${name}" parent="${parent}"
                                     use_nominal_extrinsics="${use_nominal_extrinsics}">
        <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
      </xacro:camera_body_gemini335le>
    </xacro:if>
    <!-- TODO(d555): макрос camera_body_d555 (документ 04, раздел 5) -->

    <xacro:if value="${add_gz_sensor}">
      <xacro:include filename="$(find quasi_camera_description)/urdf/gz/gz_rgbd_camera.xacro"/>
      <xacro:gz_rgbd_camera name="${name}" model="${camera_model}" preview="${preview}"/>
    </xacro:if>
  </xacro:macro>
</robot>
