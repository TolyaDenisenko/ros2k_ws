<?xml version="1.0"?>
<robot name="quasi_cart_sim" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="laser_visual"    default="true"/>
  <xacro:arg name="imu_visual"      default="false"/>
  <xacro:arg name="tof_visual"      default="false"/>
  <xacro:arg name="camera_visual" default="true"/>
  <!-- false, если Sensors-система уже объявлена в world-файле (см. cart_with_arm) -->
  <xacro:arg name="model_sensors_plugin" default="true"/>

  <!-- Привод в симуляции. diff (по умолчанию) — gz DiffDrive: крутит ведущие колёса
       drive_wheel_*_joint, тележка едет за счёт сцепления колёс с полом (две задние
       ведущие колеса, два передних кастера). velocity — прежний VelocityControl: задаёт
       скорость всему корпусу, колёса не вращаются; при длинном заднем ходе тележка
       с рукой заваливалась (STATUS K10). Выбор: xacro-аргумент sim_drive. -->
  <xacro:arg name="sim_drive" default="diff"/>
  <xacro:arg name="sim_wheel_radius" default="0.065"/>
  <xacro:if value="${'$(arg sim_drive)' == 'diff'}">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <topic>/model/cart/cmd_vel</topic>
        <left_joint>drive_wheel_left_joint</left_joint>
        <right_joint>drive_wheel_right_joint</right_joint>
        <wheel_separation>${sim_wheel_separation}</wheel_separation>
        <wheel_radius>$(arg sim_wheel_radius)</wheel_radius>
        <!-- пределы, как у Nav2 (nav2_cart.yaml): вперёд 0.4, назад 0.2 м/с; запас по ускорению
             не даёт колёсам рвануть сильнее, чем держит сцепление -->
        <max_linear_velocity>1.1</max_linear_velocity>
        <min_linear_velocity>-0.75</min_linear_velocity>
        <max_angular_velocity>1.5</max_angular_velocity>
        <min_angular_velocity>-1.5</min_angular_velocity>
        <max_linear_acceleration>1.5</max_linear_acceleration>
        <min_linear_acceleration>-1.5</min_linear_acceleration>
        <max_angular_acceleration>3.0</max_angular_acceleration>
        <min_angular_acceleration>-3.0</min_angular_acceleration>
        <!-- одометрия тележки идёт от OdometryPublisher (ниже, /model/cart/tf);
             собственную одометрию DiffDrive уводим на другие топики -->
        <odom_publish_frequency>5</odom_publish_frequency>
        <odom_topic>/model/cart/diff_odom</odom_topic>
        <tf_topic>/model/cart/diff_tf</tf_topic>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:unless value="${'$(arg sim_drive)' == 'diff'}">
    <gazebo>
      <plugin
              filename="ignition-gazebo-velocity-control-system"
              name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/cart/cmd_vel</topic>
      </plugin>
    </gazebo>
  </xacro:unless>

  <!-- <gazebo>
    <plugin
      filename="ignition-gazebo-mecanum-drive-system"
      name="ignition::gazebo::systems::MecanumDrive">
      <topic>/model/r2/cmd_vel</topic>
      <front_left_joint>wheel_front_left_joint</front_left_joint>
      <front_right_joint>wheel_front_right_joint</front_right_joint>
      <back_left_joint>wheel_rear_left_joint</back_left_joint>
      <back_right_joint>wheel_rear_right_joint</back_right_joint>
      <wheel_separation>0.3787</wheel_separation>
      <wheelbase>0.268</wheelbase>
      <wheel_radius>0.076</wheel_radius>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
    </plugin>
  </gazebo> -->

  <gazebo>
    <plugin
            filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_topic>/model/cart/odom</odom_topic>
      <tf_topic>/model/cart/tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_frame>odom</odom_frame>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>

  <gazebo>
    <xacro:if value="$(arg model_sensors_plugin)">
      <plugin
        filename="ignition-gazebo-sensors-system"
        name="ignition::gazebo::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </xacro:if>
    <plugin
      filename="ignition-gazebo-imu-system"
      name="ignition::gazebo::systems::Imu">
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/model/cart/imu</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <frame_id>imu_link</frame_id>
      <always_on>true</always_on>
      <visualize>$(arg imu_visual)</visualize>
      <update_rate>50</update_rate>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
    <material>Gazebo/Grey</material>
  </gazebo>

  <xacro:if value="$(arg enable_floor_tofs)">
<gazebo reference="tof1_link">
    <material>Gazebo/FlatBlack</material>
    <sensor type="gpu_ray" name="tof_sensor1">
      <topic>/model/cart/tof_sensor1/scan</topic>
      <ignition_frame_id>tof1_link</ignition_frame_id>
      <frame_id>tof1_link</frame_id>
      <update_rate>10</update_rate>
      <visualize>$(arg tof_visual)</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>18</samples>
            <resolution>1</resolution>
            <min_angle>${-pi/180.0*9.0}</min_angle>
            <max_angle>${pi/180.0*9.0}</max_angle>
          </horizontal>
          <vertical>
            <samples>18</samples>
            <resolution>1</resolution>
            <min_angle>${-pi/180.0*9.0}</min_angle>
            <max_angle>${pi/180.0*9.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.01</min>
          <max>5.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
</xacro:if>

  <xacro:if value="$(arg enable_floor_tofs)">
<gazebo reference="tof2_link">
    <material>Gazebo/FlatBlack</material>
    <sensor type="gpu_ray" name="tof_sensocart">
