          </horizontal>
          <vertical>
            <samples>18</samples>
            <resolution>1</resolution>
            <min_angle>${-pi/180.0*9.0}</min_angle>
            <max_angle>${pi/180.0*9.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.01</min>
          <max>5.0</max>
