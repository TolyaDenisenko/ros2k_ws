<?xml version="1.0" ?>
<!--
  Цилиндрический блок на столе для тестирования захватов вакуумным гриппером.
  Поза блока по умолчанию: (0.35, -0.75, стол+h/2). Меняя <pose>, меняем место
  объекта на столе — grasp_analyzer пересчитает варианты захвата по данным камеры.
-->
<sdf version="1.6">
  <model name="cylinder_block">
    <static>true</static>
    <pose>0.35 -0.75 1.045 0 0 0</pose>

    <link name="link">
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>   <!-- диаметр 80 мм -->
            <length>0.09</length>   <!-- высота 90 мм -->
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.45 0.1 1</ambient>
          <diffuse>0.9 0.45 0.1 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.09</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
