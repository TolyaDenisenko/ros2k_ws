<?xml version="1.0" ?>
<robot name="quasi_c2" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:property name="cart_version" value="v2"/>

  <link
    name="base_link">
    <inertial>
      <origin xyz="-0.27725 0.0 0.05" rpy="0 0 0" />   <!-- origin xyz="-0.27725 -0.013104 0.36186" rpy="0 0 0" /-->
      <mass
        value="22.927" />
      <inertia
        ixx="0.3233"
        ixy="-0.00017094"
        ixz="-0.00024758"
        iyy="0.51569"
        iyz="-7.4266E-06"
        izz="0.42086" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find quasi_cart_description)/meshes/base_link_c2-v3.stl" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="file://$(find quasi_cart_description)/meshes/base_link_c2-v3.stl" />
      </geometry>
    </collision>
  </link>

  <joint name="drive_joint" type="fixed">
    <origin xyz="0.262500000000001 0 0" rpy="0 0 0" />
    <parent link="drive_link" />
    <child link="base_link" />
    <axis xyz="0 0 0" />
  </joint>

  <joint
    name="tof1"
    type="fixed">
    <origin xyz="0.35421357900179 0.216399228992693 0.865972431864313" rpy="0 0.523598775598304 0.349065850398865"/>
    <parent
      link="base_link" />
    <child
      link="tof1_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <joint
    name="tof2"
    type="fixed">
    <origin xyz="0.34158716751688 0.229145174973094 0.865972431864313" rpy="0 0.523598775598304 1.22173047639603"/>
    <parent
      link="base_link" />
    <child
      link="tof2_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <joint
    name="tof3"
    type="fixed">
    <origin xyz="-0.341399228992681 0.22921357900177 0.865972431864309" rpy="0 0.523598775598319 1.91986217719376"/>
    <parent
      link="base_link" />
    <child
      link="tof3_link" />
