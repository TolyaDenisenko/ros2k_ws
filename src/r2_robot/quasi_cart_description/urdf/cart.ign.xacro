<?xml version="1.0"?>
<robot name="quasi_cart_sim" xmlns:xacro="http://ros.org/wiki/xacro">

    <!--gazebo reference='base_joint'>
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo-->

    <gazebo reference="base_link">
        <visual>
            <material> <!-- Black -->
                <ambient>.175 .175 .175  1.0</ambient>
                <diffuse>.175 .175 .175  1.0</diffuse>
                <specular>.175 .175 .175 1.000000</specular>
            </material>
        </visual>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.05</mu> <!-- value range 0.0 to 1.0 -->
                        <mu2>0.01</mu2> <!-- value range 0.0 to 1.0 -->
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="wheel_fr_link">
        <visual>
            <material>
                <ambient>0.7 0.7 0 1</ambient>
                <diffuse>0.7 0.7 0 1</diffuse>
                <specular>0 0 0 0</specular>
            </material>
        </visual>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.05</mu> <!-- value range 0.0 to 1.0 -->
                        <mu2>0.01</mu2> <!-- value range 0.0 to 1.0 -->
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="wheel_fl_link">
        <visual>
            <material>
                <ambient>0.7 0.7 0 1</ambient>
                <diffuse>0.7 0.7 0 1</diffuse>
                <specular>0 0 0 0</specular>
            </material>
        </visual>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>0.05</mu> <!-- value range 0.0 to 1.0 -->
                        <mu2>0.01</mu2> <!-- value range 0.0 to 1.0 -->
                    </ode>
                </friction>
            </surface>
        </collision>
    </gazebo>

</robot>