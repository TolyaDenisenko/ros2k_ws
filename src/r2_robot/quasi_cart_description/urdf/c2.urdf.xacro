  </joint>

  <xacro:if value="$(arg enable_floor_tofs)">
    <joint name="tof21" type="fixed">
      <origin xyz="0.345056026239848 0.0832988119985873 0.10848410447539" rpy="0 0.261799387799147 0"/>
      <parent link="base_link"/>
      <child link="tof21_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <joint name="tof22" type="fixed">
      <origin xyz="0.214667903902918 0.229787668687166 0.101159458124952" rpy="0.123848034899439 0.327201015683136 1.94033196039821"/>
      <parent link="base_link"/>
      <child link="tof22_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <joint name="tof23" type="fixed">
      <origin xyz="-0.344696114890031 0.0833225787385996 0.108655469766721" rpy="0 0.261799387799118 -3.14159265358979"/>
      <parent link="base_link"/>
      <child link="tof23_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <joint name="tof24" type="fixed">
      <origin xyz="-0.344696114890031 -0.0832774212614005 0.108655469766721" rpy="0 0.261799387799118 -3.14159265358979"/>
      <parent link="base_link"/>
      <child link="tof24_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <joint name="tof25" type="fixed">
      <origin xyz="0.214472454385853 -0.229797353747837 0.101181225087596" rpy="-0.123848034899449 0.327201015683136 -1.94033196039823"/>
      <parent link="base_link"/>
      <child link="tof25_link"/>
      <axis xyz="0 0 0"/>
    </joint>
    <joint name="tof26" type="fixed">
      <origin xyz="0.344861202620747 -0.0832788119986094 0.108503422991916" rpy="0 0.26179938779915 0"/>
      <parent link="base_link"/>
      <child link="tof26_link"/>
      <axis xyz="0 0 0"/>
    </joint>
  </xacro:if>

  <joint
    name="lidar"
    type="fixed">
    <origin xyz="0 0 0.428099999999984" rpy="3.14159265358979 0 3.14159265358979"/>
    <parent
      link="base_link" />
    <child
      link="lidar_link" />
    <axis
      xyz="0 0 0" />
  </joint>


  <joint
    name="imu"
    type="fixed">
    <origin xyz="0 0 0.0368399999999839" rpy="0 0 ${pi}"/>
    <parent
      link="base_link" />
    <child
      link="imu_link" />
    <axis
      xyz="0 0 0" />
  </joint>


    <!-- Симуляция (gz DiffDrive): колёса вращаются (continuous, обе оси +y, т.к. DiffDrive применяет
       один знак скорости к обоим колёсам). В исходной модели c1 — revolute с пределами 0..0 и левой осью -y.
       sim_wheel_separation — расстояние между ведущими колёсами, м (считано по суставам). -->
  <xacro:property name="sim_wheel_separation" value="0.354" />

  <joint
    name="drive_wheel_right_joint"
    type="continuous">
    <origin xyz="0 -0.177 0" rpy="0 0 0"/>
    <parent
      link="drive_link" />
    <child
      link="drive_wheel_right_link" />
    <axis
      xyz="0 1 0" />
    <limit effort="60" velocity="20" />
  </joint>
  <joint
    name="drive_wheel_left_joint"
    type="continuous">
    <origin xyz="0 0.177 0" rpy="0 0 0"/>
    <parent
      link="drive_link" />
    <child
      link="drive_wheel_left_link" />
    <axis
      xyz="0 1 0" />
    <limit effort="60" velocity="20" />
  </joint>

  <joint
      name="caster_wheel_right_bracket_joint"
      type="fixed">
    <origin xyz="0.546500000000003 -0.173649999999996 0.0764999999999789" rpy="0 0 0"/>
    <parent
        link="drive_link" />
    <child
        link="caster_wheel_right_bracket_link" />
    <axis
        xyz="0 0 0" />
  </joint>
  <joint
      name="caster_wheel_left_bracket_joint"
      type="fixed">
    <origin xyz="0.546500000000003 0.173649999999996 0.0764999999999758" rpy="0 0 0"/>
    <parent
        link="drive_link" />
    <child
        link="caster_wheel_left_bracket_link" />
    <axis
        xyz="0 0 0" />
  </joint>

  <xacro:if value="$(arg enable_camera_realsense)">
      <xacro:property name="camera_offset_x" value="0.306276790340651"/>
      <xacro:property name="camera_offset_y" value="0.00025"/>
      <xacro:property name="camera_offset_z" value="0.82083"/>
      <xacro:property name="camera_roll" value="${-pi}"/>
      <xacro:property name="camera_pitch" value="-0.041"/>
      <xacro:property name="camera_yaw" value="0.0"/>
  </xacro:if>
  <xacro:if value="$(arg enable_camera_oak)">
      <xacro:property name="camera_offset_x" value="0.306276790340651"/>
      <xacro:property name="camera_offset_y" value="0.00025"/>
      <xacro:property name="camera_offset_z" value="0.82083"/>
      <xacro:property name="camera_roll" value="${-pi}"/>
      <xacro:property name="camera_pitch" value="-0.041"/>
      <xacro:property name="camera_yaw" value="0.0"/>
  </xacro:if>
  <xacro:if value="$(arg enable_camera_orbbec)">
      <xacro:property name="camera_offset_x" value="0.309124077438916"/>
      <xacro:property name="camera_offset_y" value="0.0"/>
      <xacro:property name="camera_offset_z" value="0.839651263498303"/>
      <xacro:property name="camera_roll" value="${-pi}"/>
      <xacro:property name="camera_pitch" value="0.041"/>
      <xacro:property name="camera_yaw" value="0.0"/>
  </xacro:if>

</robot>