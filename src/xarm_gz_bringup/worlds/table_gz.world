<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane
      </uri>
    </include>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun
      </uri>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <name>table</name>
      <pose>0.0 -0.84 0 0 0 0</pose>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- (2022-12-20) humble: change gravity from [0 0 -9.81] to [0 0 0] -->
      <gravity>0 0 0</gravity>
    </physics>

  
    <!-- Цилиндрический блок встроен (копия cylinder_block.world): include
         model://cylinder_block не находился — это world-файл, а не модель
         в GZ_SIM_RESOURCE_PATH, и gz sim завершался с Error Code 14. -->
    <model name="cylinder_block">
      <static>true</static>
      <pose>0.35 -0.75 1.045 0 0 0</pose>

      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.04</radius>   <!-- диаметр 80 мм -->
              <length>0.09</length>   <!-- высота 90 мм -->
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.45 0.1 1</ambient>
            <diffuse>0.9 0.45 0.1 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.04</radius>
              <length>0.09</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>