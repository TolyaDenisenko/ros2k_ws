  <xacro:if value="$(arg enable_camera_realsense)">
    <xacro:include filename="_d455.urdf.xacro" />
    <xacro:sensor_d455 name="realsense" parent="base_link" use_nominal_extrinsics="true">
        <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}" rpy="${camera_roll + camera_roll_offset} ${camera_pitch + camera_pitch_offset} ${camera_yaw}"/> <!-- 0.331613 -->
    </xacro:sensor_d455>
  </xacro:if>

  <xacro:if value="$(arg enable_camera_oak)">
    <xacro:include filename="$(find depthai_descriptions)/urdf/include/depthai_macro.urdf.xacro"/>
    <xacro:depthai_camera camera_name="camera" camera_model="OAK-D-PRO" parent="base_link" base_frame="camera"
        cam_pos_x="${camera_offset_x}" cam_pos_y="${camera_offset_y}" cam_pos_z="${camera_offset_z}"
        cam_roll="${camera_roll + camera_roll_offset}" cam_pitch="${camera_pitch + camera_pitch_offset}" cam_yaw="${camera_yaw}" />
  </xacro:if>

  <xacro:if value="$(arg enable_camera_orbbec)">
    <xacro:include filename="$(find orbbec_description)/urdf/gemini_335_L_336_L.urdf.xacro"/>
    <joint name="orbbec_camera_joint" type="fixed">
      <origin xyz="${camera_offset_x} ${camera_offset_y} ${camera_offset_z}" rpy="${camera_roll + camera_roll_offset} ${camera_pitch + camera_pitch_offset} ${camera_yaw}" />
      <parent link="base_link" />
      <child link="camera_bottom_screw_frame" />
      <axis xyz="0 0 0" />
    </joint>
  </xacro:if>

</robot>
