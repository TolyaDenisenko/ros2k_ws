<?xml version="1.0" ?>
<!--
  Простейший world без Fuel-зависимостей (для оффлайн-запуска):
  плоский пол + стол (box) + цилиндрический блок на столе.
-->
<sdf version="1.6">
  <world name="cart_xarm_world_offline">

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Стол: столешница на z ~ 0.95 -->
    <model name="table_simple">
      <static>true</static>
      <pose>1.7 0.0 0 0 0 0</pose>
      <link name="link">
        <visual name="top_visual">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
        <collision name="top_collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><box><size>1.2 0.8 0.05</size></box></geometry>
        </collision>
        <visual name="leg_visual">
          <pose>0 0 0.425 0 0 0</pose>
          <geometry><box><size>1.1 0.7 0.85</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <collision name="leg_collision">
          <pose>0 0 0.425 0 0 0</pose>
          <geometry><box><size>1.1 0.7 0.85</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Цилиндрический блок (r=0.04, h=0.09) по центру стола -->
    <model name="cylinder_block">
      <static>true</static>
      <pose>1.85 0.10 1.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.04</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material>
        </visual>
        <collision name="collision">
          <geometry><cylinder><radius>0.04</radius><length>0.09</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

  </world>
</sdf>
