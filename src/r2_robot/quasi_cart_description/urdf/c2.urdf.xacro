    <parent
      link="base_link" />
    <child
      link="tof10_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <joint
    name="tof11"
    type="fixed">
    <origin xyz="-0.28178603896932 0.217604636143906 0.121440005169987" rpy="0 -0.8901179185171 1.5707963267949"/>
    <parent
      link="base_link" />
    <child
      link="tof11_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <joint
    name="tof12"
    type="fixed">
    <origin xyz="-0.34220463614391 0.157186038969316 0.121440005169987" rpy="0 -0.890117918517111 3.14159265358977"/>
